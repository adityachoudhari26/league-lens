# Development only. Existing .env.local holds provider credentials: do not overwrite it.
# just setup copies this to .env.development; just loads that file. Shell exports take precedence.
# Direct Go commands still require exported environment variables.
DATABASE_URL=postgres://league_lens:league_lens_local@127.0.0.1:54329/league_lens?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
POSTGRES_PORT=54329
POSTGRES_PASSWORD=league_lens_local
LIVE_SCORES=true

# Local dashboard owner, not authentication.
LOCAL_OWNER_EMAIL=owner@localhost
